def matrix_chain_order(dims):
    # n is the actual number of matrices
    n = len(dims) - 1
    
    # Create a 2D table to store the minimum multiplication costs
    # m[i][j] will hold the cost for multiplying matrices from index i to j
    m = [[0] * (n + 1) for _ in range(n + 1)]
    
    # L represents the length of the chain of matrices we are looking at
    for L in range(2, n + 1):
        for i in range(1, n - L + 2):
            j = i + L - 1
            m[i][j] = float('inf')  # Start with an infinitely large cost
            
            # Try splitting the chain at every possible position 'k'
            for k in range(i, j):
                # Formula: Cost of left part + Cost of right part + Cost of multiplying the two results
                cost = m[i][k] + m[k + 1][j] + dims[i - 1] * dims[k] * dims[j]
                
                # Keep the smallest cost found
                if cost < m[i][j]:
                    m[i][j] = cost
                    
    # The answer for the full chain (from matrix 1 to n) is at m[1][n]
    return m[1][n]

# Example Usage:
if __name__ == "__main__":
    # Dimensions of 4 matrices: 40x20, 20x30, 30x10, 10x30
    matrix_dimensions = [40, 20, 30, 10, 30]
    
    minimum_operations = matrix_chain_order(matrix_dimensions)
    print(f"The minimum number of multiplications needed is: {minimum_operations}")
